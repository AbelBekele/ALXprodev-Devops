#!/bin/bash

# Check if data.json exists
if [ ! -f "data.json" ]; then
    echo "Error: data.json not found. Please run apiAutomation-0x00 first."
    exit 1
fi

# Use jq, awk, and sed to extract and format the data
read name type weight height << EOF
$(jq -r '[.name, .types[0].type.name, .weight, .height] | @tsv' data.json | \
awk '{
    name = toupper(substr($1,1,1)) substr($1,2)
    type = toupper(substr($2,1,1)) substr($2,2)
    weight = $3/10
    height = $4/10
    print name, type, weight, height
}' | sed 's/"//g')
EOF

# Format weight and height
formatted_weight=$weight
formatted_height=$height

# Print using the exact required format
echo "$name is of type $type, weighs ${formatted_weight}kg, and is ${formatted_height}m tall." 