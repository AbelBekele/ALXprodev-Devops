#!/bin/bash

# Check if data.json exists
if [ ! -f "data.json" ]; then
    echo "Error: data.json not found. Please run apiAutomation-0x00 first."
    exit 1
fi

# Extract all required data using jq and process with awk
jq -r '[.name, .types[0].type.name, .weight, .height] | @tsv' data.json | \
awk '{
    # Capitalize first letter of name and type
    name = toupper(substr($1,1,1)) substr($1,2)
    type = toupper(substr($2,1,1)) substr($2,2)
    # Convert weight and height
    weight = $3/10
    height = $4/10
    # Print in required format
    printf "%s is of type %s, weighs %gkg, and is %.1fm tall.\n", 
           name, type, weight, height
}' | sed 's/"//g' 