#!/bin/bash

# Check if data.json exists
if [ ! -f "data.json" ]; then
    echo "Error: data.json not found. Please run apiAutomation-0x00 first."
    exit 1
fi

# Extract name
name=$(jq -r '.name' data.json | sed 's/./\u&/')

# Extract type
type=$(jq -r '.types[0].type.name' data.json | sed 's/./\u&/')

# Extract and format weight (convert hectograms to kg)
weight=$(jq -r '.weight' data.json)
formatted_weight=$(echo "scale=1; $weight/10" | bc)

# Extract and format height (convert decimeters to meters)
height=$(jq -r '.height' data.json)
formatted_height=$(echo "scale=1; $height/10" | bc)

# Print the formatted string using the exact required format
echo "$name is of type $type, weighs ${formatted_weight}kg, and is ${formatted_height}m tall." 