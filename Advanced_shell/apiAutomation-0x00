#!/bin/bash

# Define variables
API_URL="https://pokeapi.co/api/v2/pokemon/pikachu"
OUTPUT_FILE="data.json"
ERROR_FILE="errors.txt"

# Create Advanced_shell directory if it doesn't exist
mkdir -p "$(dirname "$0")"

# Make API request and handle the response
curl -s "$API_URL" -o "$OUTPUT_FILE" 2> "$ERROR_FILE"

# Check if the request was successful
if [ $? -eq 0 ] && [ -s "$OUTPUT_FILE" ]; then
    echo "Successfully retrieved Pikachu data and saved to $OUTPUT_FILE"
else
    echo "Error occurred while fetching data. Check $ERROR_FILE for details"
    exit 1
fi 