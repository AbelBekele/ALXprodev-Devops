#!/bin/bash

# Define output files
CSV_FILE="pokemon_summary.csv"
STATS_FILE="pokemon_stats.txt"

# Check if pokemon_data directory exists
if [ ! -d "pokemon_data" ]; then
    echo "Error: pokemon_data directory not found. Please run batchProcessing-0x02 first."
    exit 1
fi

# Create CSV header
echo "Name,Height(m),Weight(kg)" > "$CSV_FILE"

# Process each JSON file and create CSV entries
for file in pokemon_data/*.json; do
    # Skip if it's not a file
    [ -f "$file" ] || continue
    
    # Extract data using jq and format with awk
    jq -r '[.name, .height, .weight] | @csv' "$file" | \
    awk -F',' '{
        name = toupper(substr($1,1,1)) substr($1,2)
        # Convert height to meters and weight to kg
        height = $2/10
        weight = $3/10
        printf "%s,%.1f,%.1f\n", name, height, weight
    }' >> "$CSV_FILE"
done

# Calculate averages using awk
awk -F',' '
    NR > 1 {
        total_height += $2
        total_weight += $3
        count++
    }
    END {
        avg_height = total_height/count
        avg_weight = total_weight/count
        printf "Average Height: %.2f m\nAverage Weight: %.2f kg\nTotal Pokemon: %d\n", 
               avg_height, avg_weight, count
    }' "$CSV_FILE" > "$STATS_FILE"

# Print summary
echo "Summary report generated:"
echo "- CSV file: $CSV_FILE"
echo "- Statistics file: $STATS_FILE"
echo
echo "Statistics:"
cat "$STATS_FILE" 